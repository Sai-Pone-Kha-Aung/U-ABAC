{
  "name": "u-abac",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:seed": "turbo run db:seed",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "dev:api": "turbo run dev --filter @u-abac/backend",
    "dev:web": "turbo run dev --filter @u-abac/frontend",
    "dev:admin": "turbo run dev --filter @u-abac/admin"
  },
  "devDependencies": {
    "@u-abac/typescript-config": "workspace:*",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
